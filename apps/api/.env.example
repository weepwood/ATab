# mock：不调用外部模型，用于本地开发和测试
# openai-compatible：调用兼容 Chat Completions + JSON Schema 的服务
ATAB_AI_PROVIDER=mock

# 仅在 openai-compatible 模式下需要
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_MS=30000

# 使用 openai-compatible 时必须显式填写扩展的精确 Origin，例如：
# chrome-extension://abcdefghijklmnopabcdefghijklmnop
AI_ALLOWED_ORIGINS=

# 第一阶段 API 只允许监听本机回环地址，不支持无认证公网部署。
HOST=127.0.0.1
PORT=8787
