# mock：不调用外部模型，用于本地开发和测试
# openai-compatible：调用兼容 Chat Completions、JSON Schema 与 Embeddings 的服务
ATAB_AI_PROVIDER=mock

# disabled：仅用于受信任的本地开发环境
# supabase：生产推荐，要求有效的 Supabase 用户 Bearer Token
AI_AUTH_MODE=disabled
AI_RATE_LIMIT_PER_MINUTE=60

# 仅在 openai-compatible 模式下需要
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_REQUEST_TIMEOUT_MS=30000

# Supabase 增量同步与 AI 用户认证。只使用公开 anon key。
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 逗号分隔。开发时默认还允许 localhost 和 chrome-extension:// 来源。
AI_ALLOWED_ORIGINS=

HOST=127.0.0.1
PORT=8787
