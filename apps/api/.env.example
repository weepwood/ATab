# mock：不调用外部模型，用于本地开发和测试
# openai-compatible：调用兼容 Chat Completions、JSON Schema 与 Embeddings 的服务
ATAB_AI_PROVIDER=mock

# 仅在 openai-compatible 模式下需要
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_REQUEST_TIMEOUT_MS=30000

# Supabase 增量同步。只使用公开 anon key，用户身份由 Bearer Token + RLS 验证。
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 逗号分隔。开发时默认还允许 localhost 和 chrome-extension:// 来源。
AI_ALLOWED_ORIGINS=

HOST=127.0.0.1
PORT=8787
